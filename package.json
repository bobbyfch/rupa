{
  "name": "rupa",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "dev:worker": "wrangler dev -c worker/wrangler.toml",
    "deploy:worker": "wrangler deploy -c worker/wrangler.toml",
    "ingest:cleveland": "node scripts/ingest/cleveland.mjs",
    "ingest:games": "node scripts/ingest/games.mjs",
    "ingest:anime": "node scripts/ingest/anime.mjs",
    "ingest:catalog": "node scripts/ingest/build-catalog.mjs",
    "verify:data": "node scripts/ingest/verify.mjs",
    "check:sources": "node scripts/health/check-sources.mjs",
    "ingest:met": "node scripts/ingest/met.mjs",
    "ingest:commons": "node scripts/ingest/commons.mjs",
    "ingest:ebooks": "node scripts/ingest/standardebooks.mjs",
    "ingest:wikidata": "node scripts/ingest/wikidata.mjs",
    "ingest:wikidata-images": "node scripts/ingest/wikidata-images.mjs",
    "ingest:librivox": "node scripts/ingest/librivox.mjs",
    "coverage": "node scripts/health/write-coverage.mjs",
    "ingest:wellcome": "node scripts/ingest/wellcome.mjs",
    "ingest:smithsonian": "node scripts/ingest/smithsonian.mjs",
    "ingest:nasa": "node scripts/ingest/nasa.mjs",
    "local:covers": "node scripts/local/fetch-covers.mjs",
    "verify:ghibli": "node scripts/verify/verify-ghibli-index.mjs",
    "refresh:ghibli": "node scripts/ingest/build-ghibli-collection.mjs",
    "refresh:apple-trends": "node scripts/ingest/apple-trends.mjs",
    "refresh:game-trends": "node scripts/ingest/steam-trending.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "gifenc": "^1.0.3",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "yet-another-react-lightbox": "^3.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
